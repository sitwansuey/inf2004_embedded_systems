{
  "name": "picocar-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "nexusui": "2.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
