{
    "env": {
        "picoIncludePath": [
            "${workspaceFolder}/include",
            "${workspaceFolder}/config",
            "${workspaceFolder}/kernel/knlinc",
            "${workspaceFolder}/kernel/tkernel",
            "${workspaceFolder}/app_program"
        ],
        "picoDefines": [
            "_PICO_RP2040_",
            "CNF_SMP=1",
            "APP_TEST=0",
            "APP_S2_ONLY=0",
            "APP_S4_ONLY=0",
            "S2_ENCODER_ENABLED=0",
            "S2_COMMAND_TIMEOUT_MS=1000",
            "TM_CONSOLE_USB_CDC=1",
            "TM_CONSOLE_UART=0",
            "TM_WIFI_CYW43=1",
            "BOARD_UART0_FREE=1"
        ]
    },
    "configurations": [
        {
            "name": "Win32",
            "compilerPath": "${env:USERPROFILE}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gcc.exe",
            "compilerArgs": [
                "-mcpu=cortex-m0plus",
                "-mthumb",
                "-ffreestanding"
            ],
            "intelliSenseMode": "windows-gcc-arm",
            "includePath": [
                "${picoIncludePath}"
            ],
            "defines": [
                "${picoDefines}"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++14"
        },
        {
            "name": "Linux",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m0plus",
                "-mthumb",
                "-ffreestanding"
            ],
            "intelliSenseMode": "linux-gcc-arm",
            "includePath": [
                "${picoIncludePath}"
            ],
            "defines": [
                "${picoDefines}"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++14"
        }
    ],
    "version": 4,
    "enableConfigurationSquiggles": true
}