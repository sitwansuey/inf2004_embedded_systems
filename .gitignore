# Build artifacts
*.elf
*.uf2
*.map
*.o
*.d
build_make/tools/elf2uf2
build_make/tools/elf2uf2.exe
build_make/.build_profile

# Real WiFi credentials -- never commit these. Copy config/wifi_secrets.example.h
# to config/wifi_secrets.h and fill in your own network's SSID/password.
config/wifi_secrets.h

# Videos are shared as unlisted YouTube links (videos/README.md), never committed
*.mp4
*.mov
*.webm
*.avi
*.mkv

# macOS
.DS_Store

# Buddy 4 host-test build output
app_program/subsystem4/tests/host/.build/

# Per-checkout overrides (robot_config.h holds the defaults).
**/robot_config.local.h

# Generated test files
testing/integration/.build/
**/__pycache__/

# EDR generated report
edr-check-report.json

# Supplementary documentation, evidence and session records remain local.
# Promote selected final-submission evidence explicitly when ready.
/docs/*
!/docs/DATA_REPRESENTATION.md
/testing/evidence/
/testing/**/logs/
/testing/**/*.md
!/testing/README.md
/app_program/subsystem*/README.md
*.log
/testing/subsystem4/*.json
/testing/integration/protocol_golden.json

